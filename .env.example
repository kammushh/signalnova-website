# SignalNova website — configuration. Copy to .env and fill in. Never commit .env.

# ── Site ─────────────────────────────────────────────────────────────────
# Public address, used in e-mailed download links. No trailing slash.
SITE_URL=https://signalnova.example.com
# Signs the verification codes. Required, at least 32 characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
# Port uvicorn listens on (127.0.0.1 only). LivingLab uses 8000 on the same server.
PORT=8001
# Behind the Cloudflare Tunnel the visitor IP is in CF-Connecting-IP. Keep true
# as long as uvicorn only listens on 127.0.0.1.
TRUST_CF_HEADER=true

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signalnova
DB_USER=signalnova
DB_PASSWORD=

# ── Whitepaper file ──────────────────────────────────────────────────────
# Kept outside the web root; only served through a verified download link.
WHITEPAPER_PATH=private/whitepaper.pdf
# File name the visitor's browser saves it as
WHITEPAPER_FILENAME=SignalNova-whitepaper.pdf

# ── E-mail (SMTP) ────────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development: e-mails are printed to the log instead.
# Production (docs/DEPLOYMENT.md §7): Brevo free plan, 300 e-mails/day, sends
# from your own domain. SMTP_USER/PASSWORD = Brevo → SMTP & API → SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SignalNova <no-reply@your-domain>"
# Where replies go (Cloudflare Email Routing forwards it to your inbox)
SMTP_REPLY_TO=hello@your-domain
# Alternative, Gmail (~500/day, sends as the Gmail address; needs 2-step
# verification and an app password):
#   SMTP_HOST=smtp.gmail.com  SMTP_USER=you@gmail.com  SMTP_PASSWORD=<app password>
#   SMTP_FROM="SignalNova <you@gmail.com>"

# ── Limits (defaults shown) ──────────────────────────────────────────────
# CODE_MINUTES=15                  code validity
# CODE_MAX_ATTEMPTS=5              wrong guesses before a new code is needed
# RESEND_COOLDOWN_SECONDS=30
# CODES_PER_EMAIL_HOUR=5
# CODES_PER_IP_HOUR=10
# MAIL_DAILY_LIMIT=200             codes per 24 h; keep below your provider's cap / 2 (Brevo: 140)
# DOWNLOAD_LINK_HOURS=72
# DOWNLOAD_LINK_MAX_USES=10
# UNVERIFIED_RETENTION_DAYS=30     manage.py purge
